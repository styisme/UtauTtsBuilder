<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UtauTtsBuilder.MainPage"
             BackgroundColor="#F7F7FB"
             Title="UTAU 声库生成器">

    <ContentPage.Resources>
        <Style x:Key="SectionLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#374151" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <Style x:Key="HintLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="#9CA3AF" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Stroke" Value="#E5E7EB" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="10" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#512BD4" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#F3F0FF" />
            <Setter Property="TextColor" Value="#512BD4" />
            <Setter Property="BorderColor" Value="#DDD6FE" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#6B7280" />
            <Setter Property="BorderColor" Value="#E5E7EB" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,0" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="18,24,18,40" Spacing="20">

            <!-- ===== 顶部标题 ===== -->
            <VerticalStackLayout Spacing="6">
                <Label Text="UTAU 声库生成器"
                       FontSize="26" FontAttributes="Bold"
                       TextColor="#111827" />
                <Label Text="从系统 TTS 引擎一键生成声库"
                       FontSize="12" TextColor="#6B7280" />
            </VerticalStackLayout>

            <!-- ===== ① 语言 ===== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="① 声库语言" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <Picker x:Name="LanguagePicker"
                            Title="选择语言"
                            TextColor="#111827"
                            TitleColor="#9CA3AF"
                            FontSize="15" />
                </Border>
            </VerticalStackLayout>

            <!-- ===== ② TTS 引擎 ===== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="② TTS 引擎" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <Picker x:Name="EnginePicker"
                            Title="请选择引擎"
                            TextColor="#111827"
                            TitleColor="#9CA3AF"
                            FontSize="15"
                            SelectedIndexChanged="OnEngineChanged" />
                </Border>
                <Button x:Name="RefreshBtn"
                        Text="刷新引擎列表"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnRefreshClicked" />
            </VerticalStackLayout>

            <!-- ===== ③ 声库名称 ===== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="③ 声库名称" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <Entry x:Name="NameEntry"
                           Placeholder="例如: 小艺"
                           PlaceholderColor="#9CA3AF"
                           TextColor="#111827"
                           FontSize="15" />
                </Border>
            </VerticalStackLayout>

            <!-- ===== ④ 图标 ===== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="④ 图标（可选）" Style="{StaticResource SectionLabel}" />
                <Label Text="建议 100×100 的 PNG / BMP / JPG"
                       Style="{StaticResource HintLabel}" />
                <Label x:Name="IconLabel"
                       Text="未选择"
                       FontSize="12" TextColor="#6B7280"
                       Margin="4,0,0,0" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            x:Name="PickIconBtn"
                            Text="选择图标"
                            Style="{StaticResource SecondaryButton}"
                            Clicked="OnPickIconClicked" />
                    <Button Grid.Column="1"
                            x:Name="ClearIconBtn"
                            Text="清除"
                            Style="{StaticResource GhostButton}"
                            Clicked="OnClearIconClicked" />
                </Grid>
            </VerticalStackLayout>

            <!-- ===== ⑤ 立绘 ===== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="⑤ 立绘（可选）" Style="{StaticResource SectionLabel}" />
                <Label Text="仅 OpenUtau 会显示立绘，原版 UTAU 忽略"
                       Style="{StaticResource HintLabel}" />
                <Label x:Name="PortraitLabel"
                       Text="未选择"
                       FontSize="12" TextColor="#6B7280"
                       Margin="4,0,0,0" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            x:Name="PickPortraitBtn"
                            Text="选择立绘"
                            Style="{StaticResource SecondaryButton}"
                            Clicked="OnPickPortraitClicked" />
                    <Button Grid.Column="1"
                            x:Name="ClearPortraitBtn"
                            Text="清除"
                            Style="{StaticResource GhostButton}"
                            Clicked="OnClearPortraitClicked" />
                </Grid>
            </VerticalStackLayout>

            <!-- ===== ⑥ 作者 ===== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="⑥ 作者（可选）" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <Entry x:Name="AuthorEntry"
                           Placeholder="默认: Auto-generated"
                           PlaceholderColor="#9CA3AF"
                           TextColor="#111827"
                           FontSize="15" />
                </Border>
            </VerticalStackLayout>

            <!-- ===== ⑦ 输出路径 ===== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="⑦ 输出路径（可选）" Style="{StaticResource SectionLabel}" />
                <Label Text="留空 = 内部存储/Download/UtauTtsBuilder/"
                       Style="{StaticResource HintLabel}" />
                <Border Style="{StaticResource Card}">
                    <Entry x:Name="OutputDirEntry"
                           Placeholder="例如: Music/Utau"
                           PlaceholderColor="#9CA3AF"
                           TextColor="#111827"
                           FontSize="15" />
                </Border>
            </VerticalStackLayout>

            <!-- ===== ZIP 选项 ===== -->
            <Border Style="{StaticResource Card}" Padding="12,8">
                <HorizontalStackLayout Spacing="8">
                    <CheckBox x:Name="ZipCheckBox"
                              IsChecked="True"
                              Color="#512BD4" />
                    <Label Text="生成后自动压缩为 ZIP"
                           FontSize="14"
                           TextColor="#111827"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- ===== 生成按钮 ===== -->
            <Button x:Name="BuildButton"
                    Text="开始生成声库"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,8,0,0"
                    Clicked="OnBuildClicked" />

            <!-- ===== 进度条 ===== -->
            <ProgressBar x:Name="ProgressBar"
                         IsVisible="False"
                         ProgressColor="#512BD4"
                         HeightRequest="6" />

            <!-- ===== 状态文字 ===== -->
            <Label x:Name="StatusLabel"
                   FontSize="12"
                   TextColor="#6B7280"
                   LineBreakMode="WordWrap"
                   Margin="4,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>