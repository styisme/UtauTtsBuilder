<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UtauTtsBuilder.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Md3Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="16,24,16,48" Spacing="24">

            <Grid ColumnDefinitions="*,Auto" Margin="4,8,0,0">
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <Label x:Name="TitleLabel" Style="{StaticResource Md3Headline}" />
                    <Label x:Name="SubtitleLabel"
                           Style="{StaticResource Md3BodySmall}"
                           Margin="4,0,0,0" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        x:Name="SettingsBtn"
                        Text="⚙"
                        FontSize="22"
                        WidthRequest="48" HeightRequest="48" CornerRadius="24"
                        Padding="0"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Md3OnSurfaceVariant}"
                        VerticalOptions="Start"
                        Clicked="OnSettingsClicked" />
            </Grid>

            <VerticalStackLayout Spacing="10">
                <Label x:Name="SecLangLabel" Style="{StaticResource Md3TitleMedium}" />
                <Border Style="{StaticResource Md3TextField}">
                    <Picker x:Name="LanguagePicker"
                            TitleColor="{DynamicResource Md3OnSurfaceVariant}"
                            TextColor="{DynamicResource Md3OnSurface}"
                            FontSize="15" />
                </Border>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            x:Name="ImportReclistBtn"
                            Style="{StaticResource Md3TonalButton}"
                            Clicked="OnImportReclistClicked" />
                    <Button Grid.Column="1"
                            x:Name="ClearReclistBtn"
                            Style="{StaticResource Md3OutlinedButton}"
                            IsVisible="False"
                            Clicked="OnClearReclistClicked" />
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label x:Name="SecEngineLabel" Style="{StaticResource Md3TitleMedium}" />
                <Border Style="{StaticResource Md3TextField}">
                    <Picker x:Name="EnginePicker"
                            TitleColor="{DynamicResource Md3OnSurfaceVariant}"
                            TextColor="{DynamicResource Md3OnSurface}"
                            FontSize="15"
                            SelectedIndexChanged="OnEngineChanged" />
                </Border>
                <Button x:Name="RefreshBtn"
                        Style="{StaticResource Md3TonalButton}"
                        Clicked="OnRefreshClicked" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label x:Name="SecNameLabel" Style="{StaticResource Md3TitleMedium}" />
                <Border Style="{StaticResource Md3TextField}">
                    <Entry x:Name="NameEntry"
                           PlaceholderColor="{DynamicResource Md3OnSurfaceVariant}"
                           TextColor="{DynamicResource Md3OnSurface}"
                           FontSize="15" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label x:Name="SecIconLabel" Style="{StaticResource Md3TitleMedium}" />
                <Label x:Name="HintIconLabel"
                       Style="{StaticResource Md3BodySmall}"
                       Margin="4,-4,0,0" />
                <Label x:Name="IconLabel"
                       FontSize="13"
                       TextColor="{DynamicResource Md3OnSurfaceVariant}"
                       Margin="4,0,0,0" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            x:Name="PickIconBtn"
                            Style="{StaticResource Md3TonalButton}"
                            Clicked="OnPickIconClicked" />
                    <Button Grid.Column="1"
                            x:Name="ClearIconBtn"
                            Style="{StaticResource Md3OutlinedButton}"
                            Clicked="OnClearIconClicked" />
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label x:Name="SecPortraitLabel" Style="{StaticResource Md3TitleMedium}" />
                <Label x:Name="HintPortraitLabel"
                       Style="{StaticResource Md3BodySmall}"
                       Margin="4,-4,0,0" />
                <Label x:Name="PortraitLabel"
                       FontSize="13"
                       TextColor="{DynamicResource Md3OnSurfaceVariant}"
                       Margin="4,0,0,0" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            x:Name="PickPortraitBtn"
                            Style="{StaticResource Md3TonalButton}"
                            Clicked="OnPickPortraitClicked" />
                    <Button Grid.Column="1"
                            x:Name="ClearPortraitBtn"
                            Style="{StaticResource Md3OutlinedButton}"
                            Clicked="OnClearPortraitClicked" />
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label x:Name="SecAuthorLabel" Style="{StaticResource Md3TitleMedium}" />
                <Border Style="{StaticResource Md3TextField}">
                    <Entry x:Name="AuthorEntry"
                           PlaceholderColor="{DynamicResource Md3OnSurfaceVariant}"
                           TextColor="{DynamicResource Md3OnSurface}"
                           FontSize="15" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label x:Name="SecOutputLabel" Style="{StaticResource Md3TitleMedium}" />
                <Label x:Name="HintOutputLabel"
                       Style="{StaticResource Md3BodySmall}"
                       Margin="4,-4,0,0" />
                <Border Style="{StaticResource Md3TextField}">
                    <Entry x:Name="OutputDirEntry"
                           PlaceholderColor="{DynamicResource Md3OnSurfaceVariant}"
                           TextColor="{DynamicResource Md3OnSurface}"
                           FontSize="15" />
                </Border>
            </VerticalStackLayout>

            <Border Style="{StaticResource Md3Card}">
                <HorizontalStackLayout Spacing="12">
                    <CheckBox x:Name="ZipCheckBox"
                              IsChecked="True"
                              Color="{DynamicResource Md3Primary}" />
                    <Label x:Name="ZipLabel"
                           FontSize="14"
                           TextColor="{DynamicResource Md3OnSurface}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Button x:Name="BuildButton"
                    Style="{StaticResource Md3FilledButton}"
                    Margin="0,8,0,0"
                    Clicked="OnBuildClicked" />

            <ProgressBar x:Name="ProgressBar"
                         IsVisible="False"
                         ProgressColor="{DynamicResource Md3Primary}"
                         BackgroundColor="{DynamicResource Md3SurfaceVariant}"
                         HeightRequest="4" />

            <Label x:Name="StatusLabel"
                   FontSize="12"
                   TextColor="{DynamicResource Md3OnSurfaceVariant}"
                   LineBreakMode="WordWrap"
                   Margin="4,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
