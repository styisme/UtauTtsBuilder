<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UtauTtsBuilder.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Md3Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="16,24,16,48" Spacing="24">

            <Grid ColumnDefinitions="*,Auto" Margin="4,8,0,0">
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <Label x:Name="TitleLabel" Style="{StaticResource Md3Headline}" />
                    <Label x:Name="SubtitleLabel"
                           Style="{StaticResource Md3BodySmall}"
                           Margin="4,0,0,0" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        x:Name="SettingsBtn"
                        Text="⚙"
                        FontSize="22"
                        WidthRequest="48" HeightRequest="48" CornerRadius="24"
                        Padding="0"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Md3OnSurfaceVariant}"
                        VerticalOptions="Start"
                        Clicked="OnSettingsClicked" />
            </Grid>

            <!-- ① 语言 -->
            <VerticalStackLayout Spacing="10">
                <Label x:Name="SecLangLabel" Style="{StaticResource Md3TitleMedium}" />

                <Border Style="{StaticResource Md3TextField}" Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               x:Name="LanguageValueLabel"
                               FontSize="15"
                               VerticalOptions="Center"
                               TextColor="{DynamicResource Md3OnSurface}" />
                        <Label Grid.Column="1"
                               Text="▾"
                               FontSize="16"
                               VerticalOptions="Center"
                               TextColor="{DynamicResource Md3OnSurfaceVariant}" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLanguageTapped" />
                        </Border.GestureRecognizers>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            x:Name="ImportReclistBtn"
                            Style="{StaticResource Md3TonalButton}"
                            Clicked="OnImportReclistClicked" />
                    <Button Grid.Column="1"
                            x:Name="ClearReclistBtn"
                            Style="{StaticResource Md3OutlinedButton}"
                            IsVisible="False"
                            Clicked="OnClearReclistClicked" />
                </Grid>
            </VerticalStackLayout>

            <!-- ② 引擎 -->
            <VerticalStackLayout Spacing="10">
                <Label x:Name="SecEngineLabel" Style="{StaticResource Md3TitleMedium}" />

                <Border Style="{StaticResource Md3TextField}" Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               x:Name="EngineValueLabel"
                               FontSize="15"
                               VerticalOptions="Center"
                               TextColor="{DynamicResource Md3OnSurface}" />
                        <Label Grid.Column="1"
                               Text="▾"
                               FontSize="16"
                               VerticalOptions="Center"
                               TextColor="{DynamicResource Md3OnSurfaceVariant}" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEngineTapped" />
                        </Border.GestureRecognizers>
                    </Grid>
                </Border>

                <Button x:Name="RefreshBtn"
                        Style="{StaticResource Md3TonalButton}"
                        Clicked="OnRefreshClicked" />
            </VerticalStackLayout>

            <!-- 语音调优 -->
            <VerticalStackLayout Spacing="10">
                <Label x:Name="SecTuneLabel" Style="{StaticResource Md3TitleMedium}" />

                <Border Style="{StaticResource Md3Card}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="SpeedLabel" Grid.Column="0"
                                   FontSize="14"
                                   TextColor="{DynamicResource Md3OnSurface}"
                                   VerticalOptions="Center" />
                            <Label x:Name="SpeedValue" Grid.Column="1"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{DynamicResource Md3Primary}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Slider x:Name="SpeedSlider"
                                Minimum="0.5" Maximum="1.5"
                                Value="0.85"
                                MinimumTrackColor="{DynamicResource Md3Primary}"
                                MaximumTrackColor="{DynamicResource Md3OutlineVariant}"
                                ThumbColor="{DynamicResource Md3Primary}"
                                ValueChanged="OnSpeedChanged" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Md3Card}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="PitchLabel" Grid.Column="0"
                                   FontSize="14"
                                   TextColor="{DynamicResource Md3OnSurface}"
                                   VerticalOptions="Center" />
                            <Label x:Name="PitchValue" Grid.Column="1"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{DynamicResource Md3Primary}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Slider x:Name="PitchSlider"
                                Minimum="0.5" Maximum="2.0"
                                Value="1.0"
                                MinimumTrackColor="{DynamicResource Md3Primary}"
                                MaximumTrackColor="{DynamicResource Md3OutlineVariant}"
                                ThumbColor="{DynamicResource Md3Primary}"
                                ValueChanged="OnPitchChanged" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ③ 名称 -->
            <VerticalStackLayout Spacing="10">
                <Label x:Name="SecNameLabel" Style="{StaticResource Md3TitleMedium}" />
                <Border Style="{StaticResource Md3TextField}">
                    <Entry x:Name="NameEntry"
                           PlaceholderColor="{DynamicResource Md3OnSurfaceVariant}"
                           TextColor="{DynamicResource Md3OnSurface}"
                           FontSize="15" />
                </Border>
            </VerticalStackLayout>

            <!-- ④ 图标 -->
            <VerticalStackLayout Spacing="10">
                <Label x:Name="SecIconLabel" Style="{StaticResource Md3TitleMedium}" />
                <Label x:Name="HintIconLabel"
                       Style="{StaticResource Md3BodySmall}"
                       Margin="4,-4,0,0" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            Stroke="{DynamicResource Md3Outline}"
                            StrokeThickness="1"
                            WidthRequest="64" HeightRequest="64"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{DynamicResource Md3SurfaceVariant}">
                        <Image x:Name="IconPreview"
                               Aspect="AspectFit"
                               WidthRequest="64" HeightRequest="64" />
                    </Border>
                    <Label Grid.Column="1"
                           x:Name="IconLabel"
                           FontSize="13"
                           TextColor="{DynamicResource Md3OnSurfaceVariant}"
                           VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            x:Name="PickIconBtn"
                            Style="{StaticResource Md3TonalButton}"
                            Clicked="OnPickIconClicked" />
                    <Button Grid.Column="1"
                            x:Name="ClearIconBtn"
                            Style="{StaticResource Md3OutlinedButton}"
                            Clicked="OnClearIconClicked" />
                </Grid>
            </VerticalStackLayout>

            <!-- ⑤ 立绘 -->
            <VerticalStackLayout Spacing="10">
                <Label x:Name="SecPortraitLabel" Style="{StaticResource Md3TitleMedium}" />
                <Label x:Name="HintPortraitLabel"
                       Style="{StaticResource Md3BodySmall}"
                       Margin="4,-4,0,0" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            Stroke="{DynamicResource Md3Outline}"
                            StrokeThickness="1"
                            WidthRequest="64" HeightRequest="96"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{DynamicResource Md3SurfaceVariant}">
                        <Image x:Name="PortraitPreview"
                               Aspect="AspectFit"
                               WidthRequest="64" HeightRequest="96" />
                    </Border>
                    <Label Grid.Column="1"
                           x:Name="PortraitLabel"
                           FontSize="13"
                           TextColor="{DynamicResource Md3OnSurfaceVariant}"
                           VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            x:Name="PickPortraitBtn"
                            Style="{StaticResource Md3TonalButton}"
                            Clicked="OnPickPortraitClicked" />
                    <Button Grid.Column="1"
                            x:Name="ClearPortraitBtn"
                            Style="{StaticResource Md3OutlinedButton}"
                            Clicked="OnClearPortraitClicked" />
                </Grid>
            </VerticalStackLayout>

            <!-- ⑥ 作者 -->
            <VerticalStackLayout Spacing="10">
                <Label x:Name="SecAuthorLabel" Style="{StaticResource Md3TitleMedium}" />
                <Border Style="{StaticResource Md3TextField}">
                    <Entry x:Name="AuthorEntry"
                           PlaceholderColor="{DynamicResource Md3OnSurfaceVariant}"
                           TextColor="{DynamicResource Md3OnSurface}"
                           FontSize="15" />
                </Border>
            </VerticalStackLayout>

            <!-- ⑦ 输出路径 -->
            <VerticalStackLayout Spacing="10">
                <Label x:Name="SecOutputLabel" Style="{StaticResource Md3TitleMedium}" />
                <Label x:Name="HintOutputLabel"
                       Style="{StaticResource Md3BodySmall}"
                       Margin="4,-4,0,0" />
                <Border Style="{StaticResource Md3TextField}">
                    <Entry x:Name="OutputDirEntry"
                           PlaceholderColor="{DynamicResource Md3OnSurfaceVariant}"
                           TextColor="{DynamicResource Md3OnSurface}"
                           FontSize="15" />
                </Border>
            </VerticalStackLayout>

            <!-- ZIP -->
            <Border Style="{StaticResource Md3Card}">
                <HorizontalStackLayout Spacing="12">
                    <CheckBox x:Name="ZipCheckBox"
                              IsChecked="True"
                              Color="{DynamicResource Md3Primary}" />
                    <Label x:Name="ZipLabel"
                           FontSize="14"
                           TextColor="{DynamicResource Md3OnSurface}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- 跳过已存在 -->
            <Border Style="{StaticResource Md3Card}">
                <HorizontalStackLayout Spacing="12">
                    <CheckBox x:Name="SkipExistingCheckBox"
                              IsChecked="True"
                              Color="{DynamicResource Md3Primary}" />
                    <Label x:Name="SkipExistingLabel"
                           FontSize="14"
                           TextColor="{DynamicResource Md3OnSurface}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Button x:Name="BuildButton"
                    Style="{StaticResource Md3FilledButton}"
                    Margin="0,8,0,0"
                    Clicked="OnBuildClicked" />

            <ProgressBar x:Name="ProgressBar"
                         IsVisible="False"
                         ProgressColor="{DynamicResource Md3Primary}"
                         BackgroundColor="{DynamicResource Md3SurfaceVariant}"
                         HeightRequest="4" />

            <Label x:Name="StatusLabel"
                   FontSize="12"
                   TextColor="{DynamicResource Md3OnSurfaceVariant}"
                   LineBreakMode="WordWrap"
                   Margin="4,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
