<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UtauTtsBuilder.TtsToDSPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Md3Surface}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="8,12,16,12">
            <Button Grid.Column="0" Text="←" FontSize="20" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0" BackgroundColor="Transparent" TextColor="{DynamicResource Md3OnSurface}" Clicked="OnBackClicked" />
            <Label Grid.Column="1" x:Name="TitleLabel" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource Md3OnSurface}" VerticalOptions="Center" Margin="4,0,0,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">
                
                <Label x:Name="CorpusSectionLabel" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource Md3Primary}" />
                <Border Style="{StaticResource Md3Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label x:Name="CorpusHintLabel" FontSize="12" TextColor="{DynamicResource Md3OnSurfaceVariant}" />
                        
                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ChkZh" IsChecked="True" Color="{DynamicResource Md3Primary}" />
                            <Label x:Name="LblZh" VerticalOptions="Center" TextColor="{DynamicResource Md3OnSurface}" />
                            <Label x:Name="LblZhCount" Text="(0)" VerticalOptions="Center" TextColor="{DynamicResource Md3Primary}" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                        
                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ChkJa" IsChecked="True" Color="{DynamicResource Md3Primary}" />
                            <Label x:Name="LblJa" VerticalOptions="Center" TextColor="{DynamicResource Md3OnSurface}" />
                            <Label x:Name="LblJaCount" Text="(0)" VerticalOptions="Center" TextColor="{DynamicResource Md3Primary}" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                        
                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ChkEn" IsChecked="False" Color="{DynamicResource Md3Primary}" />
                            <Label x:Name="LblEn" VerticalOptions="Center" TextColor="{DynamicResource Md3OnSurface}" />
                            <Label x:Name="LblEnCount" Text="(0)" VerticalOptions="Center" TextColor="{DynamicResource Md3Primary}" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="CustomSectionLabel" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource Md3Primary}" Margin="0,8,0,0" />
                <Border Style="{StaticResource Md3TextField}" Padding="8">
                    <Editor x:Name="TextEditor" HeightRequest="80" />
                </Border>

                <Border Style="{StaticResource Md3Card}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ChkAug" IsChecked="True" Color="{DynamicResource Md3Primary}" />
                            <Label x:Name="AugLabel" VerticalOptions="Center" TextColor="{DynamicResource Md3OnSurface}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <ProgressBar x:Name="ProgressBar" IsVisible="False" ProgressColor="{DynamicResource Md3Primary}" />
                <Label x:Name="StatusLabel" FontSize="12" TextColor="{DynamicResource Md3OnSurfaceVariant}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" x:Name="StartBtn" Style="{StaticResource Md3FilledButton}" Margin="16,0,16,24" Clicked="OnStartClicked" />
    </Grid>
</ContentPage>
