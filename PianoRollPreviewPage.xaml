<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UtauTtsBuilder.PianoRollPreviewPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Md3Surface}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="8,12,16,12">
            <Button Grid.Column="0" Text="←" FontSize="20" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0" BackgroundColor="Transparent" TextColor="{DynamicResource Md3OnSurface}" Clicked="OnBackClicked" />
            <Label Grid.Column="1" Text="序列试听" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource Md3OnSurface}" VerticalOptions="Center" Margin="4,0,0,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">
                <Label Text="输入你想试听的音节序列（用空格隔开，如：あ か さ た な）" FontSize="14" TextColor="{DynamicResource Md3OnSurfaceVariant}" />
                <Border Style="{StaticResource Md3TextField}">
                    <Entry x:Name="SequenceEntry" Text="あ か さ た な" />
                </Border>
                <Button x:Name="PlayBtn" Text="播放序列" Style="{StaticResource Md3FilledButton}" Clicked="OnPlayClicked" />
                <Label x:Name="StatusLabel" FontSize="12" TextColor="{DynamicResource Md3OnSurfaceVariant}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
