<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UtauTtsBuilder.SettingsPage"
             BackgroundColor="{DynamicResource Md3Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="16,20,16,40" Spacing="20">

            <Label x:Name="AppearanceLabel" Style="{StaticResource Md3TitleMedium}" />
            <VerticalStackLayout Spacing="8">
                <Button x:Name="ThemeAutoBtn"
                        HeightRequest="52" CornerRadius="26" FontSize="15"
                        Clicked="OnThemeModeButtonClicked" />
                <Button x:Name="ThemeLightBtn"
                        HeightRequest="52" CornerRadius="26" FontSize="15"
                        Clicked="OnThemeModeButtonClicked" />
                <Button x:Name="ThemeDarkBtn"
                        HeightRequest="52" CornerRadius="26" FontSize="15"
                        Clicked="OnThemeModeButtonClicked" />
            </VerticalStackLayout>

            <Label x:Name="LanguageSectionLabel" Style="{StaticResource Md3TitleMedium}" />
            <VerticalStackLayout Spacing="8">
                <Button x:Name="LangAutoBtn"
                        HeightRequest="52" CornerRadius="26" FontSize="15"
                        Clicked="OnLanguageButtonClicked" />
                <Button x:Name="LangZhBtn"
                        HeightRequest="52" CornerRadius="26" FontSize="15"
                        Clicked="OnLanguageButtonClicked" />
                <Button x:Name="LangEnBtn"
                        HeightRequest="52" CornerRadius="26" FontSize="15"
                        Clicked="OnLanguageButtonClicked" />
                <Button x:Name="LangJaBtn"
                        HeightRequest="52" CornerRadius="26" FontSize="15"
                        Clicked="OnLanguageButtonClicked" />
            </VerticalStackLayout>

            <Label x:Name="DynamicLabel" Style="{StaticResource Md3TitleMedium}" />
            <Border Style="{StaticResource Md3Card}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label x:Name="DynamicTitle" FontSize="14"
                               TextColor="{DynamicResource Md3OnSurface}" />
                        <Label x:Name="DynamicHint" FontSize="12"
                               TextColor="{DynamicResource Md3OnSurfaceVariant}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1"
                            x:Name="DynamicSwitch"
                            OnColor="{DynamicResource Md3Primary}"
                            Toggled="OnDynamicToggled"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <Label x:Name="DynamicFooter"
                   FontSize="12"
                   TextColor="{DynamicResource Md3OnSurfaceVariant}"
                   Margin="4,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
