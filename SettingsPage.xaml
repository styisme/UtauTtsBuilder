<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UtauTtsBuilder.SettingsPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Md3Surface}">
    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,40" Spacing="20">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                <Button Grid.Column="0" Text="←" FontSize="20" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0" BackgroundColor="Transparent" TextColor="{DynamicResource Md3OnSurface}" Clicked="OnBackClicked" />
                <Label Grid.Column="1" x:Name="TopTitle" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource Md3OnSurface}" VerticalOptions="Center" />
            </Grid>

            <!-- 外观 -->
            <Label x:Name="AppearanceLabel" Style="{StaticResource Md3TitleMedium}" />
            <VerticalStackLayout Spacing="8">
                <Button x:Name="ThemeAutoBtn"  Style="{StaticResource Md3TonalButton}" Clicked="OnThemeModeButtonClicked" />
                <Button x:Name="ThemeLightBtn" Style="{StaticResource Md3TonalButton}" Clicked="OnThemeModeButtonClicked" />
                <Button x:Name="ThemeDarkBtn"  Style="{StaticResource Md3TonalButton}" Clicked="OnThemeModeButtonClicked" />
            </VerticalStackLayout>

            <!-- UI 风格 -->
            <Label x:Name="UiStyleLabel" Style="{StaticResource Md3TitleMedium}" />
            <VerticalStackLayout Spacing="8">
                <Button x:Name="StyleMd3Btn"     Style="{StaticResource Md3TonalButton}" Clicked="OnUiStyleClicked" />
                <Button x:Name="StyleHarmonyBtn" Style="{StaticResource Md3TonalButton}" Clicked="OnUiStyleClicked" />
                <Button x:Name="StyleUwpBtn"     Style="{StaticResource Md3TonalButton}" Clicked="OnUiStyleClicked" />
                <Button x:Name="StyleA4Btn"      Style="{StaticResource Md3TonalButton}" Clicked="OnUiStyleClicked" />
            </VerticalStackLayout>

            <!-- 语言 -->
            <Label x:Name="LanguageSectionLabel" Style="{StaticResource Md3TitleMedium}" />
            <VerticalStackLayout Spacing="8">
                <Button x:Name="LangAutoBtn" Style="{StaticResource Md3TonalButton}" Clicked="OnLanguageButtonClicked" />
                <Button x:Name="LangZhBtn"   Style="{StaticResource Md3TonalButton}" Clicked="OnLanguageButtonClicked" />
                <Button x:Name="LangEnBtn"   Style="{StaticResource Md3TonalButton}" Clicked="OnLanguageButtonClicked" />
                <Button x:Name="LangJaBtn"   Style="{StaticResource Md3TonalButton}" Clicked="OnLanguageButtonClicked" />
            </VerticalStackLayout>

            <!-- 动态取色 -->
            <Label x:Name="DynamicLabel" Style="{StaticResource Md3TitleMedium}" />
            <Border Style="{StaticResource Md3Card}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label x:Name="DynamicTitle" FontSize="14" TextColor="{DynamicResource Md3OnSurface}" />
                        <Label x:Name="DynamicHint" FontSize="12" TextColor="{DynamicResource Md3OnSurfaceVariant}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="DynamicSwitch" OnColor="{DynamicResource Md3Primary}" Toggled="OnDynamicToggled" VerticalOptions="Center" />
                </Grid>
            </Border>
            <Label x:Name="DynamicFooter" FontSize="12" TextColor="{DynamicResource Md3OnSurfaceVariant}" Margin="4,0,0,0" />

            <!-- 高级设置 -->
            <Label x:Name="AdvancedLabel" Style="{StaticResource Md3TitleMedium}" />
            <Border Style="{StaticResource Md3Card}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label x:Name="ForceBuildTitle" FontSize="14" TextColor="{DynamicResource Md3OnSurface}" />
                        <Label x:Name="ForceBuildHint" FontSize="12" TextColor="{DynamicResource Md3OnSurfaceVariant}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="ForceBuildSwitch" OnColor="{DynamicResource Md3Primary}" Toggled="OnForceBuildToggled" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- 本地 AI 模型 -->
            <Label x:Name="AiSectionTitle" Style="{StaticResource Md3TitleMedium}" />
            <Border Style="{StaticResource Md3Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="AiEngineName" FontSize="14" TextColor="{DynamicResource Md3OnSurface}" />
                            <Label x:Name="AiModelStatusLabel" FontSize="12" TextColor="{DynamicResource Md3OnSurfaceVariant}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" x:Name="DownloadAiBtn" Style="{StaticResource Md3TonalButton}" Clicked="OnDownloadAiClicked" />
                    </Grid>
                    <ProgressBar x:Name="AiDownloadProgress" IsVisible="False" ProgressColor="{DynamicResource Md3Primary}" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="CloudBtn" Style="{StaticResource Md3TonalButton}" Margin="0,8,0,0" Clicked="OnCloudSettingsClicked" />
            <Button x:Name="AboutBtn" Style="{StaticResource Md3OutlinedButton}" Clicked="OnAboutClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
