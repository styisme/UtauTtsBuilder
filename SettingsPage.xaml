<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UtauTtsBuilder.SettingsPage"
             Title="设置"
             BackgroundColor="{DynamicResource Md3Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="16,20,16,40" Spacing="20">

            <!-- ===== 外观模式 ===== -->
            <Label Text="外观" Style="{StaticResource Md3TitleMedium}" />

            <Border Style="{StaticResource Md3Card}">
                <VerticalStackLayout Spacing="4">
                    <RadioButton x:Name="ThemeAuto"
                                 Content="跟随系统"
                                 GroupName="ThemeMode"
                                 TextColor="{DynamicResource Md3OnSurface}"
                                 CheckedChanged="OnThemeModeChanged" />
                    <RadioButton x:Name="ThemeLight"
                                 Content="浅色"
                                 GroupName="ThemeMode"
                                 TextColor="{DynamicResource Md3OnSurface}"
                                 CheckedChanged="OnThemeModeChanged" />
                    <RadioButton x:Name="ThemeDark"
                                 Content="深色"
                                 GroupName="ThemeMode"
                                 TextColor="{DynamicResource Md3OnSurface}"
                                 CheckedChanged="OnThemeModeChanged" />
                </VerticalStackLayout>
            </Border>

            <!-- ===== 动态取色 ===== -->
            <Label Text="动态取色" Style="{StaticResource Md3TitleMedium}" />

            <Border Style="{StaticResource Md3Card}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2"
                                         VerticalOptions="Center">
                        <Label Text="使用壁纸颜色"
                               FontSize="14"
                               TextColor="{DynamicResource Md3OnSurface}" />
                        <Label Text="仅 Android 12+ 有效"
                               FontSize="12"
                               TextColor="{DynamicResource Md3OnSurfaceVariant}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1"
                            x:Name="DynamicSwitch"
                            OnColor="{DynamicResource Md3Primary}"
                            Toggled="OnDynamicToggled"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- ===== 底部说明 ===== -->
            <Label Text="关闭动态取色后，应用会使用 MD3 基线紫作为主题色。"
                   FontSize="12"
                   TextColor="{DynamicResource Md3OnSurfaceVariant}"
                   Margin="4,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
