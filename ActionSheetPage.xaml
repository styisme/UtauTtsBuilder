<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UtauTtsBuilder.ActionSheetPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Md3Surface}">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              Padding="8,12,16,12">
            <Button Grid.Column="0"
                    Text="←"
                    FontSize="20"
                    WidthRequest="44" HeightRequest="44"
                    CornerRadius="22" Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource Md3OnSurface}"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1"
                   x:Name="TitleLabel"
                   FontSize="18" FontAttributes="Bold"
                   TextColor="{DynamicResource Md3OnSurface}"
                   VerticalOptions="Center"
                   Margin="4,0,0,0"
                   LineBreakMode="WordWrap" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="ActionsContainer"
                                 Padding="16,8,16,16"
                                 Spacing="8" />
        </ScrollView>

        <Button Grid.Row="2"
                x:Name="CancelBtn"
                Style="{StaticResource Md3OutlinedButton}"
                Margin="16,8,16,24"
                Clicked="OnCancelClicked" />
    </Grid>
</ContentPage>
